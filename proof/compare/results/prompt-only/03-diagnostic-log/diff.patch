+/**
+ * A new stock map with quantity fewer of a sku, or an InsufficientStockError.
+ * A shortfall is first logged as one JSON line of sku, wanted, and available, through `log`.
+ */
+export function reserve(stock, sku, quantity, log = console.warn) {
   assertPositiveInteger("quantity", quantity);
   const available = stock[sku] ?? 0;
   if (available < quantity) {
+    log(JSON.stringify({ event: "reserve-insufficient-stock", sku, wanted: quantity, available }));
     throw new InsufficientStockError(sku, quantity, available);
   }
   return { ...stock, [sku]: available - quantity };
