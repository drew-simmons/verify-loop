+
+/**
+ * Computes the refund amount for an order based on the reason.
+ * - "damaged": full total amount
+ * - "late": shipping cost only
+ * - "changed-mind": net amount minus 10% restocking fee
+ * - any other reason: 0
+ */
+export function computeRefund(order, reason) {
+  switch (reason) {
+    case "damaged":
+      return order.total;
+    case "late":
+      return order.shipping.cost;
+    case "changed-mind":
+      return percentOf(order.net, 0.9);
+    default:
+      return 0;
+  }
+}
