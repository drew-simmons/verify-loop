+
+const RESTOCKING_RATE = 0.1;
+
+/**
+ * The cents to refund for an order, by reason. "damaged" refunds the total, "late" the
+ * shipping cost, "changed-mind" the net less a 10% restocking fee. Other reasons refund nothing.
+ */
+export function refundFor(order, reason) {
+  switch (reason) {
+    case "damaged":
+      return order.total;
+    case "late":
+      return order.shipping.cost;
+    case "changed-mind":
+      return order.net - percentOf(order.net, RESTOCKING_RATE);
+    default:
+      return 0;
+  }
+}
