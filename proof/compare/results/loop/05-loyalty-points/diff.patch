diff --git a/src/pricing.js b/src/pricing.js
index b00e393..68fc6e7 100644
--- a/src/pricing.js
+++ b/src/pricing.js
@@ -29,3 +29,28 @@ export function priceCart(cart, catalog, code) {
   const discount = discountFor(base, code);
   return { subtotal: base, discount, net: base - discount };
 }
+
+/** Points multiplier by membership tier. Anyone not listed earns at the base rate. */
+const TIER_MULTIPLIERS = { silver: 2, gold: 3 };
+
+/** Whether a discount code halves the points: it does for everyone but gold members. */
+const HALVED_BY_DISCOUNT = { gold: false };
+
+const EXPRESS_BONUS = 50;
+
+/** Points for the member tier and express shipping of an order, before any halving. */
+function rawPoints(net, member, express) {
+  const base = Math.floor(net / 100) * (TIER_MULTIPLIERS[member] ?? 1);
+  return express ? base + EXPRESS_BONUS : base;
+}
+
+/**
+ * Loyalty points earned on an order: one per whole dollar of the net amount in cents,
+ * times 2 for silver and 3 for gold, plus 50 for express shipping. A discount code
+ * halves the total, bonus included, unless the member is gold. Always a whole number.
+ */
+export function loyaltyPoints(net, { member, express = false, discounted = false } = {}) {
+  const points = rawPoints(net, member, express);
+  const halved = discounted && (HALVED_BY_DISCOUNT[member] ?? true);
+  return halved ? Math.floor(points / 2) : points;
+}
diff --git a/test/pricing.test.js b/test/pricing.test.js
index c7af054..3abad4d 100644
--- a/test/pricing.test.js
+++ b/test/pricing.test.js
@@ -2,7 +2,7 @@ import { test } from "node:test";
 import assert from "node:assert/strict";
 import { addItem, emptyCart } from "../src/cart.js";
 import { createCatalog } from "../src/catalog.js";
-import { discountFor, priceCart, subtotal } from "../src/pricing.js";
+import { discountFor, loyaltyPoints, priceCart, subtotal } from "../src/pricing.js";
 
 const catalog = createCatalog([
   { sku: "MUG", name: "Mug", priceCents: 1250, weightKg: 0.4 },
@@ -34,3 +34,28 @@ test("an unknown code takes nothing off", () => {
 test("pricing a cart reports subtotal, discount, and the net", () => {
   assert.deepEqual(priceCart(cart, catalog, "FLAT500"), { subtotal: 2800, discount: 500, net: 2300 });
 });
+
+test("loyalty points are one per whole dollar of net, dropping the cents", () => {
+  assert.equal(loyaltyPoints(2399), 23);
+  assert.equal(loyaltyPoints(99), 0);
+});
+
+test("silver members earn double and gold members triple", () => {
+  assert.equal(loyaltyPoints(2300, { member: "silver" }), 46);
+  assert.equal(loyaltyPoints(2300, { member: "gold" }), 69);
+  assert.equal(loyaltyPoints(2300, { member: "bronze" }), 23);
+});
+
+test("express shipping adds a 50 point bonus", () => {
+  assert.equal(loyaltyPoints(2300, { express: true }), 73);
+});
+
+test("a discount code halves the points, rounding down, except for gold", () => {
+  assert.equal(loyaltyPoints(2500, { discounted: true }), 12);
+  assert.equal(loyaltyPoints(2300, { member: "silver", discounted: true }), 23);
+  assert.equal(loyaltyPoints(2300, { member: "gold", discounted: true }), 69);
+});
+
+test("the discount halving applies to the express bonus too", () => {
+  assert.equal(loyaltyPoints(2300, { express: true, discounted: true }), 36);
+});
