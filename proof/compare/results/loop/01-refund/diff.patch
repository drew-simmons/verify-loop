+const RESTOCKING_FEE_RATE = 0.1;
+
+const REFUND_RULES = new Map([
+  ["damaged", (order) => order.total],
+  ["late", (order) => order.shipping.cost],
+  ["changed-mind", (order) => order.net - percentOf(order.net, RESTOCKING_FEE_RATE)],
+]);
+
+/**
+ * Refund in cents for an order: "damaged" refunds the total, "late" the shipping cost,
+ * "changed-mind" the net minus a 10% restocking fee. Any other reason refunds nothing.
+ */
+export function refundFor(order, reason) {
+  const rule = REFUND_RULES.get(reason);
+  return rule ? rule(order) : 0;
+}
