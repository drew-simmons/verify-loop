 });
 
 test("tax rounds to the nearest cent", () => {
-  assert.equal(taxFor(2300, "CA"), 167);
-  assert.equal(taxFor(2300, "TX"), 144);
+  assert.equal(taxFor(2300, "CA", rates), 167);
