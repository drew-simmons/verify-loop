+
+/** The receipt line for one cart line: its sku and quantity. */
+function lineText({ sku, quantity }) {
+  return `${sku} x${quantity}`;
+}
+
+/** The discount receipt line, or no lines at all when the order has no discount. */
+function discountLines(order, currency) {
+  return order.discount > 0 ? [`Discount: ${formatCents(order.discount, currency)}`] : [];
+}
+
+/**
+ * A printable multi-line receipt for an order: one line per cart line, then subtotal,
+ * discount (only when there is one), tax, shipping with its tier, and total,
+ * with amounts formatted like "USD 12.50".
+ */
+export function receipt(order, currency) {
+  return [
+    ...order.lines.map(lineText),
+    `Subtotal: ${formatCents(order.subtotal, currency)}`,
+    ...discountLines(order, currency),
+    `Tax: ${formatCents(order.tax, currency)}`,
+    `Shipping (${order.shipping.tier}): ${formatCents(order.shipping.cost, currency)}`,
+    `Total: ${formatCents(order.total, currency)}`,
+  ].join("\n");
+}
