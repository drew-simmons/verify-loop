+  const records = [];
+  const record = (entry) => records.push(entry);
+  assert.throws(() => reserve({ MUG: 2 }, "MUG", 5, record), InsufficientStockError);
+  assert.throws(() => reserve({}, "PEN", 1, record), InsufficientStockError);
+  assert.deepEqual(records, [
+    { sku: "MUG", wanted: 5, available: 2 },
