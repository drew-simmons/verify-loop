+
+test("late reason refunds only the shipping cost", () => {
+  const cart = addItem(addItem(emptyCart(), "MUG", 2), "DESK", 1);
+  const { order } = placeOrder(
+    { cart, catalog, stock: { MUG: 5, DESK: 1 }, discountCode: "FLAT500", region: "CA", zone: "domestic", express: true },
+    deps,
+  );
+  const refund = refundAmount(order, "late");
+  assert.equal(refund, order.shipping.cost);
+});
+
+test("changed-mind reason refunds net minus 10% restocking fee", () => {
+  const cart = addItem(addItem(emptyCart(), "MUG", 2), "DESK", 1);
+  const { order } = placeOrder(
+    { cart, catalog, stock: { MUG: 5, DESK: 1 }, discountCode: "FLAT500", region: "CA", zone: "domestic", express: true },
+    deps,
