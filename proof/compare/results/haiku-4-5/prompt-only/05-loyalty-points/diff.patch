diff --git a/src/pricing.js b/src/pricing.js
index b00e393..8fbb1bf 100644
--- a/src/pricing.js
+++ b/src/pricing.js
@@ -29,3 +29,26 @@ export function priceCart(cart, catalog, code) {
   const discount = discountFor(base, code);
   return { subtotal: base, discount, net: base - discount };
 }
+
+/** Calculate loyalty points for an order. */
+export function loyaltyPoints(net, membership, hasExpressShipping, hasDiscountCode) {
+  const pointsPerDollar = Math.floor(net / 100);
+
+  let points = pointsPerDollar;
+
+  if (membership === "silver") {
+    points *= 2;
+  } else if (membership === "gold") {
+    points *= 3;
+  }
+
+  if (hasExpressShipping) {
+    points += 50;
+  }
+
+  if (hasDiscountCode && membership !== "gold") {
+    points = Math.floor(points / 2);
+  }
+
+  return points;
+}
