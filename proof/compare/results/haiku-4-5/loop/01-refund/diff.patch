diff --git a/src/refunds.js b/src/refunds.js
new file mode 100644
index 0000000..ef270d0
--- /dev/null
+++ b/src/refunds.js
@@ -0,0 +1,20 @@
+import { percentOf } from "./money.js";
+
+/**
+ * Computes the refund amount for an order based on the reason.
+ * "damaged" refunds the full total, "late" refunds the shipping cost,
+ * "changed-mind" refunds the net amount minus a 10% restocking fee,
+ * and any other reason refunds nothing. Returns amount in cents.
+ */
+export function computeRefund(order, reason) {
+  switch (reason) {
+    case "damaged":
+      return order.total;
+    case "late":
+      return order.shipping.cost;
+    case "changed-mind":
+      return order.net - percentOf(order.net, 0.1);
+    default:
+      return 0;
+  }
+}
