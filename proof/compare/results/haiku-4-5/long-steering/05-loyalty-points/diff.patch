 const catalog = createCatalog([
   { sku: "MUG", name: "Mug", priceCents: 1250, weightKg: 0.4 },
@@ -34,3 +34,43 @@ test("an unknown code takes nothing off", () => {
 test("pricing a cart reports subtotal, discount, and the net", () => {
   assert.deepEqual(priceCart(cart, catalog, "FLAT500"), { subtotal: 2800, discount: 500, net: 2300 });
 });
+
+test("loyalty points are one per whole dollar of net amount", () => {
+  assert.equal(loyaltyPoints(10000, null, false, false), 100);
+  assert.equal(loyaltyPoints(15050, null, false, false), 150);
+  assert.equal(loyaltyPoints(99, null, false, false), 0);
+});
+
+test("silver members earn double points", () => {
+  assert.equal(loyaltyPoints(10000, "silver", false, false), 200);
+  assert.equal(loyaltyPoints(15000, "silver", false, false), 300);
+});
+
+test("gold members earn triple points", () => {
+  assert.equal(loyaltyPoints(10000, "gold", false, false), 300);
+  assert.equal(loyaltyPoints(15000, "gold", false, false), 450);
+});
+
+test("express shipping adds a 50 point bonus", () => {
+  assert.equal(loyaltyPoints(10000, null, false, true), 150);
+  assert.equal(loyaltyPoints(10000, "silver", false, true), 250);
+  assert.equal(loyaltyPoints(10000, "gold", false, true), 350);
+});
+
+test("discount codes halve the points for regular and silver members", () => {
+  assert.equal(loyaltyPoints(10000, null, true, false), 50);
+  assert.equal(loyaltyPoints(10000, "silver", true, false), 100);
+});
+
+test("gold members keep all points even with a discount code", () => {
+  assert.equal(loyaltyPoints(10000, "gold", true, false), 300);
+});
+
+test("discount halves the points after express bonus for non-gold members", () => {
+  assert.equal(loyaltyPoints(10000, null, true, true), 75);
+  assert.equal(loyaltyPoints(10000, "silver", true, true), 125);
+});
+
+test("gold members with express and discount keep points including bonus", () => {
+  assert.equal(loyaltyPoints(10000, "gold", true, true), 350);
+});
