+
+/** The labelled amounts below the line items; the discount row appears only when there is one. */
+function summaryRows(order) {
+  const rows = [["Subtotal", order.subtotal]];
+  if (order.discount > 0) {
+    rows.push(["Discount", order.discount]);
+  }
+  rows.push(["Tax", order.tax], [`Shipping (${order.shipping.tier})`, order.shipping.cost], ["Total", order.total]);
+  return rows;
+}
+
+/** A printable multi-line receipt for a placed order, with amounts formatted in `currency`. */
+export function receipt(order, currency) {
+  const items = order.lines.map((line) => `${line.sku} x${line.quantity}`);
+  const totals = summaryRows(order).map(([label, amount]) => `${label}: ${formatCents(amount, currency)}`);
+  return [...items, ...totals].join("\n");
+}
