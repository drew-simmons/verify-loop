diff --git a/src/pricing.js b/src/pricing.js
index b00e393..c4e0913 100644
--- a/src/pricing.js
+++ b/src/pricing.js
@@ -29,3 +29,18 @@ export function priceCart(cart, catalog, code) {
   const discount = discountFor(base, code);
   return { subtotal: base, discount, net: base - discount };
 }
+
+/** Loyalty points earned on an order. One per whole dollar of net; doubled for silver, tripled for gold; plus 50 for express; halved if a discount code was used (except gold members keep them all). */
+export function pointsEarned(net, express, membershipTier, discountUsed) {
+  let points = Math.floor(net / 100);
+  if (express) {
+    points += 50;
+  }
+  const multipliers = { silver: 2, gold: 3 };
+  const multiplier = multipliers[membershipTier] || 1;
+  points *= multiplier;
+  if (discountUsed && membershipTier !== "gold") {
+    points = Math.floor(points / 2);
+  }
+  return points;
+}
