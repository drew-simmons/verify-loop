+
+/**
+ * Whole loyalty points an order earns: per whole dollar of netCents by
+ * membership ("silver", "gold", or anything else for standard), plus a flat
+ * bonus for express shipping, halved (rounded down) when discountCents is
+ * above zero unless the member is gold.
+ */
+export function loyaltyPoints({ netCents, membership, express, discountCents }) {
+  const wholeDollars = Math.floor(cents(netCents) / CENTS_PER_DOLLAR);
+  const multiplier = POINTS_PER_DOLLAR[membership] ?? 1;
+  const earned = wholeDollars * multiplier + (express ? EXPRESS_BONUS_POINTS : 0);
+  return halvesPoints(membership, discountCents) ? Math.floor(earned / 2) : earned;
+}
