+/** Points multiplier by membership tier; any other member earns one point per dollar. */
+const TIER_MULTIPLIERS = { silver: 2, gold: 3 };
+
+/** Flat points added to an order that ships express. */
+const EXPRESS_BONUS = 50;
+
+/** Share of points kept: discounted orders keep half, except gold members who keep all. */
+function keptShare(membership, discounted) {
+  return discounted && membership !== "gold" ? 0.5 : 1;
+}
+
+/**
+ * Loyalty points for an order: one per whole dollar of the net cents, times the tier
+ * multiplier, plus the express bonus, halved (rounded down) when a discount code was
+ * used unless the member is gold. Always a whole number.
+ */
+export function loyaltyPoints(netCents, { membership, express, discounted }) {
+  const multiplier = TIER_MULTIPLIERS[membership] ?? 1;
+  const bonus = express ? EXPRESS_BONUS : 0;
+  const earned = Math.floor(netCents / 100) * multiplier + bonus;
+  return Math.floor(earned * keptShare(membership, discounted));
+}
