@@ -40,3 +41,20 @@ export function placeOrder({ cart, catalog, stock, discountCode, region, zone, e
   };
   return { order, stock: remaining };
 }
+
+const RESTOCKING_RATE = 0.1;
+
+const REFUND_RULES = {
+  damaged: (order) => order.total,
+  late: (order) => order.shipping.cost,
+  "changed-mind": (order) => order.net - percentOf(order.net, RESTOCKING_RATE),
+};
+
+/**
+ * Refund in cents for an order and a reason: "damaged" refunds the total, "late" the
+ * shipping cost, "changed-mind" the net amount less a 10% restocking fee. Any other reason refunds 0.
+ */
+export function refundFor(order, reason) {
+  const rule = Object.hasOwn(REFUND_RULES, reason) ? REFUND_RULES[reason] : () => 0;
+  return rule(order);
+}
