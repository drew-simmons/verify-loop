#!/usr/bin/env sh
# The factory's gate, callable from a terminal, a Makefile, or CI. Finds the
# installed plugin and runs its verify.sh. Generated by /factory:setup; do not edit.
set -u
if [ -z "${FACTORY_ROOT:-}" ]; then
  for d in "$HOME"/.claude/plugins/cache/factory/factory/*/ "$HOME"/.claude/plugins/marketplaces/factory/plugins/factory/; do
    [ -f "$d/skills/verify/scripts/verify.sh" ] && FACTORY_ROOT=${d%/} && break
  done
fi
[ -n "${FACTORY_ROOT:-}" ] || { echo "verify: the factory plugin is not installed; in Claude Code run /plugin install factory@factory, or set FACTORY_ROOT to a checkout of github.com/drew-simmons/factory/plugins/factory" >&2; exit 2; }
exec sh "$FACTORY_ROOT/skills/verify/scripts/verify.sh" "$@"
