-export function reserve(stock, sku, quantity) {
+/**
+ * A new stock map with quantity fewer of a sku, or an InsufficientStockError.
+ * When stock falls short, `record({ sku, wanted, available })` is called before
+ * the throw, so the caller decides where the diagnostic goes; the library does no I/O.
+ */
+export function reserve(stock, sku, quantity, record) {
   assertPositiveInteger("quantity", quantity);
   const available = stock[sku] ?? 0;
