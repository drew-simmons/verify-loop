diff --git a/src/pricing.js b/src/pricing.js
index b00e393..9359f6d 100644
--- a/src/pricing.js
+++ b/src/pricing.js
@@ -29,3 +29,25 @@ export function priceCart(cart, catalog, code) {
   const discount = discountFor(base, code);
   return { subtotal: base, discount, net: base - discount };
 }
+
+/** Loyalty points earned: one per whole dollar of net, multiplied by member tier, plus express bonus, halved if discounted (except gold keeps all). */
+export function loyaltyPoints(netCents, memberTier, hasDiscountCode, express) {
+  let points = Math.floor(netCents / 100);
+
+  const multipliers = {
+    silver: 2,
+    gold: 3,
+  };
+  const multiplier = multipliers[memberTier] ?? 1;
+  points *= multiplier;
+
+  if (express) {
+    points += 50;
+  }
+
+  if (hasDiscountCode && memberTier !== "gold") {
+    points = Math.floor(points / 2);
+  }
+
+  return points;
+}
