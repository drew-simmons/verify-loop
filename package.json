{
  "name": "verify-loop",
  "version": "0.1.0",
  "private": true,
  "description": "A worked example of a fast verification loop for Claude Code: poly-crap, lawbook, and Hunk on the same diff",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info",
    "verify": "sh .factory/verify",
    "demo": "sh demo.sh",
    "prove": "sh proof/prove.sh",
    "bench": "sh proof/bench.sh",
    "scale": "sh proof/scale.sh",
    "compare": "sh proof/compare/compare.sh"
  }
}
