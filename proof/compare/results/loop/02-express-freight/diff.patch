diff --git a/src/shipping.js b/src/shipping.js
index 57200e4..1b8a000 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -24,19 +24,21 @@ export function weightTier(weightKg) {
   return "standard";
 }
 
+/** Suffix order by tier: freight puts "express" before "intl", the rest the reverse. */
+const SUFFIX_ORDER = {
+  freight: ["express", "intl"],
+  heavy: ["intl", "express"],
+  standard: ["intl", "express"],
+};
+
 /** The weight tier plus "intl" and "express" suffixes, joined with dashes. */
 export function shippingTier(weightKg, zone, express) {
   if (!(weightKg > 0)) {
     throw new ValidationError("weightKg", "greater than zero");
   }
-  const parts = [weightTier(weightKg)];
-  if (zone === "international") {
-    parts.push("intl");
-  }
-  if (express) {
-    parts.push("express");
-  }
-  return parts.join("-");
+  const base = weightTier(weightKg);
+  const wanted = { intl: zone === "international", express: Boolean(express) };
+  return [base, ...SUFFIX_ORDER[base].filter((suffix) => wanted[suffix])].join("-");
 }
 
 /** The cost in cents of a tier string such as "heavy-intl-express". */
