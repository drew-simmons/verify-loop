+
+/** Multi-line printable receipt: cart lines, then subtotal, discount (if any), tax, shipping, and total. */
+export function receipt(order, currency) {
+  const rows = [];
+  for (const line of order.lines) {
+    rows.push(`${line.sku} x${line.quantity}`);
+  }
+  rows.push(`Subtotal: ${formatCents(order.subtotal, currency)}`);
+  if (order.discount > 0) {
+    rows.push(`Discount: ${formatCents(order.discount, currency)}`);
+  }
+  rows.push(`Tax: ${formatCents(order.tax, currency)}`);
+  rows.push(`Shipping (${order.shipping.tier}): ${formatCents(order.shipping.cost, currency)}`);
+  rows.push(`Total: ${formatCents(order.total, currency)}`);
+  return rows.join("\n");
+}
