     \"Discount: USD 5.00\",\n      \"Tax: USD 19.50\",\n      \"Shipping (freight-express): USD 54.00\",\n      \"Total: USD 342.50\",\n    ].join(\"\\\\n\"),\n  );\n});\n\ntest(\"a receipt omits the discount line when the order has no discount\", () => {\n  assert.doesNotMatch(receipt({ ...sampleOrder, discount: 0 }, \"USD\"), /Discount/);\n});\n'''\nopen(p,'w').write(s)\np='README.md'\ns=open(p).read()\ns=s.replace('into an order record.','into an order record; `receipt` renders an order as printable text.')\nopen(p,'w').write(s)\nE\nnpm run coverage 2>&1 | grep -E \"orders|^ℹ (tests|pass|fail)|fail\"; git status --short; Bash cat >> test/orders.test.js <<'E'\n\nconst sampleOrder = {\n  lines: [\n    { sku: \"MUG\", quantity: 2 },\n    { sku: \"DESK\", quantity: 1 },\n  ],\n  subtotal: 27400,\n  discount: 500,\n  tax: 1950,\n  shipping: { tier: \"freight-express\", cost: 5400 },\n  total: 34250,\n};\n\ntest(\"a receipt lists each line, the discount, and every amount as currency\", () => {\n  assert.equal(\n    receipt(sampleOrder, \"USD\"),\n    [\n      \"MUG x2\",\n      \"DESK x1\",\n      \"Subtotal: USD 274.00\",\n      \"Discount: USD 5.00\",\n      \"Tax: USD 19.50\",\n      \"Shipping (freight-express): USD 54.00\",\n      \"Total: USD 342.50\",\n    ].join(\"\\n\"),\n  );\n});\n\ntest(\"a receipt omits the discount line when the order has no discount\", () => {\n  assert.doesNotMatch(receipt({ ...sampleOrder, discount: 0 }, \"USD\"), /Discount/);\n});\nE\nnpm run coverage 2>&1 | grep -E \"orders.js|^ℹ (tests|pass|fail)\"; git status --short",
