new file mode 100644
index 0000000..537e9d8
--- /dev/null
+++ b/load-tax-rates.js
@@ -0,0 +1,9 @@
+import { readFileSync } from "node:fs";
+
+/**
+ * Reads the sales tax rates by region from tax-rates.json at the repo root.
+ * The library is pure, so the caller loads this and passes it to placeOrder as `deps.taxRates`.
+ */
+export function loadTaxRates(path = new URL("./tax-rates.json", import.meta.url)) {
+  return JSON.parse(readFileSync(path, "utf8"));
+}
