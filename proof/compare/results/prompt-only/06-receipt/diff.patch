+
+/** A printable receipt for an order: its lines, then the amounts, each formatted in `currency`. */
+export function receipt(order, currency) {
+  const money = (amount) => formatCents(amount, currency);
+  return [
+    ...order.lines.map((line) => `${line.sku} x ${line.quantity}`),
+    `Subtotal: ${money(order.subtotal)}`,
+    ...(order.discount > 0 ? [`Discount: -${money(order.discount)}`] : []),
+    `Tax: ${money(order.tax)}`,
+    `Shipping (${order.shipping.tier}): ${money(order.shipping.cost)}`,
+    `Total: ${money(order.total)}`,
+  ].join("\n");
+}
