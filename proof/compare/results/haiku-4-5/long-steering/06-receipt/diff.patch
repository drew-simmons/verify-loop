+
+/** A printable receipt as a multi-line string. */
+export function receipt(order, currency) {
+  const receiptLines = [];
+  for (const line of order.lines) {
+    receiptLines.push(`${line.sku} ${line.quantity}`);
+  }
+  receiptLines.push("");
+  receiptLines.push(`Subtotal: ${formatCents(order.subtotal, currency)}`);
+  if (order.discount > 0) {
+    receiptLines.push(`Discount: ${formatCents(order.discount, currency)}`);
+  }
+  receiptLines.push(`Tax: ${formatCents(order.tax, currency)}`);
+  receiptLines.push(`Shipping (${order.shipping.tier}): ${formatCents(order.shipping.cost, currency)}`);
+  receiptLines.push(`Total: ${formatCents(order.total, currency)}`);
+  return receiptLines.join("\n");
+}
