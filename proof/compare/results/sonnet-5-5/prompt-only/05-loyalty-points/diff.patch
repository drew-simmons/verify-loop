+import { add, cents, percentOf } from "./money.js";
 
 /** Each discount code is a function from a subtotal to the cents it takes off. */
 const DISCOUNTS = {
@@ -29,3 +29,20 @@ export function priceCart(cart, catalog, code) {
   const discount = discountFor(base, code);
   return { subtotal: base, discount, net: base - discount };
 }
+
+/** Points multiplier by membership tier. Anyone else earns the base rate. */
+const MEMBER_MULTIPLIER = { silver: 2, gold: 3 };
+
+const EXPRESS_BONUS = 50;
+
+/**
+ * Loyalty points for an order: one per whole dollar of the net amount (in cents),
+ * times the member multiplier, plus a bonus for express shipping. Using a discount
+ * code halves the total, bonus included, unless the member is gold. Whole points,
+ * rounded down.
+ */
+export function loyaltyPoints(netCents, { member, express = false, discounted = false } = {}) {
+  const earned = Math.floor(cents(netCents) / 100) * (MEMBER_MULTIPLIER[member] ?? 1);
+  const total = earned + (express ? EXPRESS_BONUS : 0);
+  return member !== "gold" && discounted ? Math.floor(total / 2) : total;
+}
