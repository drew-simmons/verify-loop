diff --git a/src/shipping.js b/src/shipping.js
index 57200e4..d57cf64 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -24,19 +24,28 @@ export function weightTier(weightKg) {
   return "standard";
 }
 
-/** The weight tier plus "intl" and "express" suffixes, joined with dashes. */
+function tierWithExpress(tier, express) {
+  return express ? `${tier}-express` : tier;
+}
+
+function tierWithIntlExpress(tier, express, isFreight) {
+  if (!express) {
+    return `${tier}-intl`;
+  }
+  return isFreight ? `${tier}-express-intl` : `${tier}-intl-express`;
+}
+
+/** The weight tier plus "intl" and "express" suffixes, joined with dashes. For freight-international, express comes before intl. */
 export function shippingTier(weightKg, zone, express) {
   if (!(weightKg > 0)) {
     throw new ValidationError("weightKg", "greater than zero");
   }
-  const parts = [weightTier(weightKg)];
+  const tier = weightTier(weightKg);
+  const isFreight = tier === "freight";
   if (zone === "international") {
-    parts.push("intl");
-  }
-  if (express) {
-    parts.push("express");
+    return tierWithIntlExpress(tier, express, isFreight);
   }
-  return parts.join("-");
+  return tierWithExpress(tier, express);
 }
 
 /** The cost in cents of a tier string such as "heavy-intl-express". */
