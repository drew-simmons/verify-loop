+const RESTOCKING_FEE_RATE = 0.1;
+
+/** Refund in cents for each reason that pays out; any reason not listed pays nothing. */
+const REFUND_BY_REASON = new Map([
+  ["damaged", (order) => order.total],
+  ["late", (order) => order.shipping.cost],
+  ["changed-mind", (order) => order.net - percentOf(order.net, RESTOCKING_FEE_RATE)],
+]);
+
+/**
+ * Refund in cents owed on a placed order for the given reason: "damaged" refunds the
+ * total, "late" the shipping cost, "changed-mind" the net minus a 10% restocking fee.
+ * Any other reason refunds 0.
+ */
+export function refundFor(order, reason) {
+  const computeRefund = REFUND_BY_REASON.get(reason);
+  return computeRefund ? computeRefund(order) : 0;
+}
