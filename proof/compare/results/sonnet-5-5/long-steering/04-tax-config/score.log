  "denied": "Bash cat > tax-rates.json <<'EOF'\n{\n  \"CA\": 0.0725,\n  \"NY\": 0.04,\n  \"TX\": 0.0625\n}\nEOF\ncat > src/tax.js <<'EOF'\nimport { percentOf } from \"./money.js\";\nimport salesTaxRates from \"../tax-rates.json\" with { type: \"json\" };\n\n/** The tax rate for a region, zero when the region is untaxed. */\nexport function taxRate(region) {\n  return salesTaxRates[region] ?? 0;\n}\n\n/** Tax on an amount for a region, rounded to the cent. */\nexport function taxFor(amount, region) {\n  return percentOf(amount, taxRate(region));\n}\nEOF\ncat > test/tax.test.js <<'EOF'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { taxFor, taxRate } from \"../src/tax.js\";\nimport { percentOf } from \"../src/money.js\";\nimport salesTaxRates from \"../tax-rates.json\" with { type: \"json\" };\n\n// Expectations read tax-rates.json so finance can change a rate without breaking tests.\ntest(\"listed regions have the rate in tax-rates.json\", () => {\n  assert.equal(taxRate(\"CA\"), salesTaxRates.CA);\n  assert.equal(taxRate(\"NY\"), salesTaxRates.NY);\n});\n\ntest(\"unlisted regions are untaxed\", () => {\n  assert.equal(taxRate(\"OR\"), 0);\n  assert.equal(taxFor(10000, \"OR\"), 0);\n});\n\ntest(\"tax rounds to the nearest cent\", () => {\n  assert.equal(taxFor(2300, \"CA\"), percentOf(2300, salesTaxRates.CA));\n  assert.equal(taxFor(2300, \"TX\"), percentOf(2300, salesTaxRates.TX));\n});\nEOF\nsed -i 's|^- `src/tax.js`: tax rates by region.|- `src/tax.js`: tax by region, using the rates in `tax-rates.json` (finance edits that file and redeploys).|' README.md\nnpm run coverage 2>&1 | grep -E \"tax|^ℹ (pass|fail)|# (pass|fail)\"; git status --short",
