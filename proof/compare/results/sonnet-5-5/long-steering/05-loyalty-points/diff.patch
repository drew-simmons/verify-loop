+const standardOrder = { netCents: 2599, membership: "standard", express: false, discountCents: 0 };
+
+test("a standard member earns one point per whole dollar, ignoring leftover cents", () => {
+  assert.equal(loyaltyPoints(standardOrder), 25);
+});
+
+test("a silver member earns double points", () => {
+  assert.equal(loyaltyPoints({ ...standardOrder, membership: "silver" }), 50);
+});
+
+test("a gold member earns triple points", () => {
+  assert.equal(loyaltyPoints({ ...standardOrder, membership: "gold" }), 75);
+});
