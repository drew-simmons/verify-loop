+
+/** Refund amount in cents for the given reason. */
+export function refundAmount(order, reason) {
+  switch (reason) {
+    case "damaged":
+      return order.total;
+    case "late":
+      return order.shipping.cost;
+    case "changed-mind":
+      return order.net - percentOf(order.net, 0.1);
+    default:
+      return 0;
+  }
+}
